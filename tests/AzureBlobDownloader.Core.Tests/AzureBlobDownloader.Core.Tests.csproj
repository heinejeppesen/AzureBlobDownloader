<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The config file shipped with the app, so tests can check it stays valid. -->
    <None Include="..\..\src\AzureBlobDownloader.App\AzureBlobDownloader.config.json"
          Link="Shipped\AzureBlobDownloader.config.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AzureBlobDownloader.Core\AzureBlobDownloader.Core.csproj" />
  </ItemGroup>

</Project>
